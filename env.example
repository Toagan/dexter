# LLM API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MOONSHOT_API_KEY=your-moonshot-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistent memory embeddings reuse existing model API keys.
# Priority: OpenAI (OPENAI_API_KEY) -> Gemini (GOOGLE_API_KEY) -> Ollama (OLLAMA_BASE_URL)
# No additional memory-specific API keys required.

# FinancialReports.eu — sole structured-data source in this build
# (companies, filings with markdown, Capital-IQ-grade financials, ISINs, audit trails, watchlist, webhooks)
# Get a key at https://financialreports.eu/profile/
FINANCIAL_REPORTS_API_KEY=your-financial-reports-api-key
# Optional override for the API base URL (defaults to https://api.financialreports.eu)
# FINANCIAL_REPORTS_BASE_URL=https://api.financialreports.eu

# Web Search API Keys (Exa → Perplexity → Tavily) — used for live quotes, news,
# analyst estimates, and any data FinancialReports does not cover
EXASEARCH_API_KEY=your-exa-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
TAVILY_API_KEY=your-tavily-api-key

# X/Twitter API (enables x_search tool for public sentiment research)
X_BEARER_TOKEN=your-X-bearer-token

# LangSmith
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter
LANGSMITH_TRACING=false
